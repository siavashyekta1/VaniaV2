# --- GENERAL ---
DEBUG=False
SECRET_KEY=django-insecure-change-me-to-something-static-and-long
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api.vaniaapp.app,vaniaapp.app,panel.vaniaapp.app
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,http://0.0.0.0:3000,http://0.0.0.0:8000,https://api.vaniaapp.app,https://vaniaapp.app,https://panel.vaniaapp.app

# --- DATABASE ---
# 1. The Service Name is "db"
# 2. The Password is "vania_password"
DATABASE_URL=postgres://vania_user:vania_password@db:5432/vania_db
# ASGI-safe default: keep at 0 unless you use an external pooler (e.g. PgBouncer)
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# This variable is used by Docker to CREATE the database
POSTGRES_USER=vania_user
POSTGRES_PASSWORD=vania_password
POSTGRES_DB=vania_db

# --- CACHE ---
REDIS_URL=redis://cache:6379/0
USE_CELERY=True
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=200

# Gunicorn worker process count for app container
WEB_CONCURRENCY=2

# --- OBJECT STORAGE ---
USE_S3=True
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=vania-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=127.0.0.1:9000/vania-media
# AWS_S3_CUSTOM_MAIN_DOMAIN=http://127.0.0.1:9000

# # production
AWS_S3_CUSTOM_DOMAIN=files.vaniaapp.app/vania-media
AWS_S3_CUSTOM_MAIN_DOMAIN=files.vaniaapp.app

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- VECTOR DB ---
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# --- KEYS & CONFIG ---
OPENAI_API_KEY=sk-proj-xxxx
# Optional runtime-only override for isolated Stage/Demo model pilots.
# Leave empty in production to preserve each AgentService and demo model configuration.
VANIA_CHAT_MODEL_OVERRIDE=
JWT_ACCESS_MINUTES=300
JWT_REFRESH_DAYS=7

# --- ESANJ TEST API ---
ESANJ_API_BASE_URL=https://esanj.org/api/v1
ESANJ_API_USERNAME=
ESANJ_API_PASSWORD=
ESANJ_API_TIMEOUT_SECONDS=30

CSRF_TRUSTED_ORIGINS=https://api.vaniaapp.app,http://localhost:8000

# --- frontend ---
NEXT_PUBLIC_API_URL=https://api.vaniaapp.app
INTERNAL_API_URL=http://app:8000

NAJVA_API_KEY=x
NAJVA_SENDER_ID=x
SMS_SERVICE_MODE=CONSOLE
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=130433
SMSIR_PARAMETER_NAME=Code
HTTP_PROXY=
HTTPS_PROXY=
http_proxy=
https_proxy=
NO_PROXY=localhost,127.0.0.1,0.0.0.0,app,db,cache,qdrant,minio,frontend
no_proxy=localhost,127.0.0.1,0.0.0.0,app,db,cache,qdrant,minio,frontend

# --- PAYMENT GATEWAY (ZarinPal) ---
# Leave empty for Sandbox mode if DEBUG=True
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENABLE_ZARINPAL=False
ZIBAL_MERCHANT_ID=

# --- REDIRECT & DOMAIN CONFIG ---
API_DOMAIN=https://api.vaniaapp.app
FRONTEND_URL=https://panel.vaniaapp.app
APP_URL=https://panel.vaniaapp.app


LANGFUSE_ENABLED =False
LANGFUSE_PUBLIC_KEY =pk-lf-xxx
LANGFUSE_SECRET_KEY =sk-lf-xxx
LANGFUSE_HOST =https://cloud.langfuse.com
